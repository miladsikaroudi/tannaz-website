---
// Kept at /contact, the old site's address for this page. The text is in src/content/about.md.
import { Content as About } from '../content/about.md';
import Site from '../layouts/Site.astro';
import { site } from '../site';
---

<Site title={`About: ${site.name}`}>
  <section class="about">
    <h1>About</h1>
    <div class="text">
      <About />
    </div>
  </section>
</Site>

<style>
  .about {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }
  h1 {
    font-size: clamp(2.25rem, 1.2rem + 4vw, 4.75rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .text {
    max-width: 40rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .text :global(p) {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.55;
  }
  .text :global(p + p) {
    margin-top: 1.25rem;
  }
</style>
