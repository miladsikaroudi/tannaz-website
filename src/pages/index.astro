---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Site title={`${site.name}: design portfolio`} image={projects[0]?.data.cover}>
  <section class="intro">
    <h1>{site.tagline}</h1>
    <p>{site.intro}</p>
  </section>

  <section aria-labelledby="work-title">
    <h2 id="work-title" class="label">Selected work</h2>
    <ul class="grid">
      {
        projects.map((project, i) => (
          <li>
            <a class="card" href={`/work/${project.id}`}>
              <div class="frame">
                <Picture
                  src={project.data.cover}
                  alt={project.data.coverAlt}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 720px) 46vw, 92vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </div>
              <h3>{project.data.title}</h3>
              <p>{project.data.disciplines.join(' · ')}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Site>

<style>
  .intro {
    padding-block: clamp(3.5rem, 10vw, 8rem) clamp(2.5rem, 7vw, 5.5rem);
  }
  .intro h1 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.2rem + 4.4vw, 5.25rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .intro p {
    max-width: 36ch;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1.25rem, 3vw, 2.5rem);
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    display: block;
    text-decoration: none;
  }
  .frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--frame);
  }
  .frame :global(picture) {
    height: 100%;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .frame :global(img) {
    transform: scale(1.03);
  }
  .card h3 {
    margin-top: 1rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .card p {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
