---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Bands from '../../components/Bands.astro';
import Site from '../../layouts/Site.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, previous: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  previous?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, previous, next } = Astro.props;
const { Content } = await render(project);
const { title, summary, collaborator, cover, sections } = project.data;
---

<Site title={`${title}: ${site.name}`} description={summary} image={cover}>
  <article>
    <header class="head">
      <h1>{title}</h1>
      <div class="intro">
        <Content />
        {collaborator && <p>In collaboration with {collaborator.replace(/\.?$/, '.')}</p>}
      </div>
    </header>

    <Bands sections={sections} />
  </article>

  <nav class="pager" aria-label="More projects">
    {
      previous ? (
        <a rel="prev" href={`/work/${previous.id}`}>
          <span>Previous</span>
          {previous.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a rel="next" href={`/work/${next.id}`}>
          <span>Next</span>
          {next.data.title}
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Site>

<style>
  /* The title and intro, centred, as at the top of the old pages. */
  .head {
    max-width: 44rem;
    margin-inline: auto;
    padding-block: clamp(3.5rem, 10.5vw, 9.5rem);
    text-align: center;
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .intro {
    margin-top: 1.75rem;
    line-height: 1.6;
  }
  /* The old pages ran these lines together, one under the other. */
  .intro :global(p + p) {
    margin-top: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .pager a {
    display: block;
    padding-block: 0.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
  }
  .pager a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pager a span {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pager [rel='next'] {
    grid-column: 2;
    text-align: right;
  }
</style>
