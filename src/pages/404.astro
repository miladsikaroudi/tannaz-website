---
import Site from '../layouts/Site.astro';
import { site } from '../site';
---

<Site title={`Page not found: ${site.name}`}>
  <section class="missing">
    <h1>This page isn’t here</h1>
    <p><a href="/">See all the work</a></p>
  </section>
</Site>

<style>
  .missing {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }
  h1 {
    font-size: clamp(2.25rem, 1.2rem + 4vw, 4.75rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  p {
    margin-top: 1.5rem;
    font-size: 1.1875rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 0.25em;
  }
</style>
